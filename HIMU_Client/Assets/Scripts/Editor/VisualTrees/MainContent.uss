.root {
    flex-grow: 1;
    flex-direction: column;
    padding: 8px;
}

.header {
    align-items: center;
    margin-bottom: 6px;
}

.title {
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.body {
    flex-grow: 1;
}

.subtitle {
    -unity-text-align: upper-center;
    margin-bottom: 6px;
    white-space: normal;
}

.paragraph {
    white-space: normal;
    -unity-text-align: upper-center;
    margin-bottom: 10px;
    margin-top: 10px;
}

.objectSelector {
    -unity-font-style: normal;
    margin-bottom: 6px;
    margin-top: 6px;
}

.objectSelector > .unity-label {
    -unity-font-style: bold;
}

.dropdown {
    -unity-font-style: normal;
    margin-bottom: 6px;
    margin-top: 6px;
}

.dropdown > .unity-label {
    -unity-font-style: bold;
}

.footer {
    margin-top: 6px;
}
